# Except for APP_DATA, the provided values are the default ones (see README.md).
# Numeric values must be plain decimal integers, the server refuses to start
# otherwise.

# Port to listen on
# PORT=3000

# Proxy data directory (consignments, media, SQLite DB), ~/.rgb-proxy-server by
# default (~ is not expanded here, so an absolute path is needed). It must not
# be shared with another running instance, see README.md
# APP_DATA=/path/to/data

# Max allowed expires_at offset in seconds
# MAX_EXPIRY_SECS=2592000

# Max number of transfers an invoice can be reserved for
# MAX_QUOTA=100

# Max consignment/media upload size in bytes
# MAX_UPLOAD_BYTES=104857600

# Max signed TX size per transfer in ack.prepare, measured as the length of
# the base64 signed_tx string
# MAX_SIGNED_TX_SIZE=153600

# Max transfers per ack.prepare operation, also the max number of IDs in
# invoice.check, ack.get and ack.clean calls
# MAX_TRANSFERS=1000

# Max media a transfer can have (media.post)
# MAX_MEDIA=21

# Time data is kept after its expiration, in seconds: at most for pending
# transfers, always for operation data (ACKs, signatures, released signed TXs)
# RETENTION_GRACE_SECS=86400

# Time pending calls are given to complete on SIGTERM/SIGINT before being
# aborted, in seconds (the orchestrator grace period, e.g. docker stop -t,
# must be at least this long), up to 2147483
# SHUTDOWN_TIMEOUT_SECS=300

# Max time drain mode (SIGUSR2) waits for pending transfers before shutting
# down anyway, in seconds, up to 2147483; unset waits until none is pending
# DRAIN_TIMEOUT_SECS=

# Max proof of work difficulty (leading zero bits) required on
# consignment.post, 0 disables the proof of work
# MAX_POW_DIFFICULTY=24

# Recent consignment.post calls for an invoice at which its difficulty
# becomes 1, and further calls for each additional bit
# POW_RATE_THRESHOLD=10
# POW_RATE_STEP=2

# Recent consignment.post calls across all invoices at which the difficulty of
# every invoice becomes 1, and further calls for each additional bit
# POW_GLOBAL_THRESHOLD=1000
# POW_GLOBAL_STEP=50

# Time constant, in seconds, of the decay of the call counts, i.e. calls are
# counted over about this window
# POW_WINDOW_SECS=3600

# Min time, in seconds, a difficulty stays in effect before it can decrease
# POW_HOLD_SECS=600

# Comma- or whitespace-separated Ed25519 pubkeys for invoice.prepare / ack.prepare auth
# (unset by default)
# PROXY_AUTH_PUBKEYS=
